# --- Python ---
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# --- Secretos ---
.env

# --- Config local del editor ---
.claude/

# --- Respaldos de trabajo ---
# Copias que se hacen al rehacer una anotacion o una revision. Son utiles
# mientras se trabaja, pero no forman parte del entregable.
*.bak

# --- Documentos de trabajo, no del Trabajo Final ---
# El repositorio es el entregable academico: solo va lo que forma parte del TP.
CLAUDE.md
plan.md
docs/guia_github.md

# --- Material de la materia ---
# Las diapositivas y consignas son material de la catedra: no corresponde
# redistribuirlas en un repositorio publico.
Clases/

# --- Navegador ---
.playwright/

# --- Checkpoints de modelos ---
# Cada checkpoint de BETO pesa ~440 MB y GitHub rechaza archivos de mas de
# 100 MB. Se versionan los reportes de metricas (reports/), no los pesos.
models/*/
!models/.gitkeep

# --- Datos crudos del scrape ---
# El volcado completo no se redistribuye (terminos de uso del portal), pero si
# se incluye una muestra acotada para reproducibilidad academica.
data/raw/*.jsonl
!data/raw/sample_*.jsonl

# --- Fixtures HTML ---
# Son volcados de paginas del portal: NO se redistribuyen. Se generan solos al
# correr el scrape. src/agent/robustness.py cae a una muestra sintetica propia
# cuando no estan, asi que el repo sigue siendo reproducible sin ellos.
data/fixtures/
